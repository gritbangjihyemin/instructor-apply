rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'gritbangjihye@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function str(v, maxLen) { return v is string && v.size() <= maxLen; }

    // 강의 공고: 공개(모집중/마감)는 누구나 조회, 쓰기는 관리자만
    match /lectures/{id} {
      allow read: if isAdmin() || resource.data.status in ['open', 'closed'];
      allow write: if isAdmin();
    }

    // 지원서: 누구나 제출(모집중 공고에 한함), 조회·수정·삭제는 관리자만
    match /applications/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(['name','phone','email','region','career','history','education','certs','message','fields','photo','files','lectureId','lectureTitle','memo','createdAt'])
        && str(request.resource.data.name, 40) && request.resource.data.name.size() > 0
        && str(request.resource.data.phone, 20)
        && str(request.resource.data.email, 100)
        && str(request.resource.data.career, 3000) && request.resource.data.career.size() > 0
        && str(request.resource.data.history, 5000)
        && str(request.resource.data.message, 2000)
        && str(request.resource.data.photo, 400000)
        && request.resource.data.fields is list && request.resource.data.fields.size() <= 20
        && request.resource.data.files is list && request.resource.data.files.size() <= 5
        && request.resource.data.memo == ''
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/lectures/$(request.resource.data.lectureId)).data.status == 'open';
      allow read, update, delete: if isAdmin();
    }

    // 첨부파일 조각
    match /fileChunks/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(['appId','fileIdx','idx','data','createdAt'])
        && request.resource.data.appId is string
        && request.resource.data.fileIdx is int && request.resource.data.fileIdx < 5
        && request.resource.data.idx is int && request.resource.data.idx < 20
        && str(request.resource.data.data, 720000);
      allow read, delete: if isAdmin();
    }
  }
}
